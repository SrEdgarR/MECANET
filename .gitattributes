# Auto detect text files and perform LF normalization
* text=auto

# Source code
*.js text eol=lf
*.jsx text eol=lf
*.ts text eol=lf
*.tsx text eol=lf
*.json text eol=lf
*.md text eol=lf
*.html text eol=lf
*.css text eol=lf

# Scripts
*.sh text eol=lf
*.ps1 text eol=crlf

# Config files
.gitignore text eol=lf
.gitattributes text eol=lf
.env.example text eol=lf

# Documents
*.txt text eol=lf
LICENSE text eol=lf
README.md text eol=lf

# Graphics
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.svg text eol=lf

# Archives
*.zip binary
*.tar binary
*.gz binary
*.tgz binary
*.rar binary
*.7z binary

# Fonts
*.ttf binary
*.otf binary
*.woff binary
*.woff2 binary
*.eot binary

# Executable
*.exe binary
*.dll binary

# Video
*.mp4 binary
*.mov binary
*.avi binary
*.webm binary

# Reproducible local documentation and byte-exact adopted methodology
docs/project-map/*.mjs text eol=lf
docs/methodology/Prompt_Maestro_v2.0.md -text

# Keep CP-006 experimental script hashes reproducible across checkouts
.agentic/experiments/cp006/*.mjs text eol=lf
.agentic/experiments/cp006/*.cjs text eol=lf

# Keep CP-010 local Mongo harness hash reproducible across checkouts
.agentic/experiments/cp010/*.cjs text eol=lf

# Immutable approved fragments exported directly from Git in CP-015
docs/specs/p1-l1-approved/*.md -text
docs/specs/p1-l2-approved/*.md -text
docs/specs/p1-l3-approved/*.md -text

# New recovery sources keep their frozen byte identity on all checkouts.
tests/qa/cp019/*.mjs text eol=lf
tests/qa/cp019/*.py text eol=lf
tests/integration/*.mjs text eol=lf
server/saas/db/migrations/006-*.sql text eol=lf

# Reproduce CI module text and preserve raw CP-016 evidence file hashes.
scripts/ci/*.mjs text eol=lf
docs/evidence/cp016/** -text whitespace=trailing-space,space-before-tab,cr-at-eol

# CP027 reviewed verification sources and raw receipts retain byte identity.
.github/workflows/p1-l3-continuation.yml text eol=lf
tests/qa/cp027/*.mjs text eol=lf
docs/evidence/cp027/** -text

# CP028 executable test text and immutable sanitized receipts
tests/qa/cp028/*.mjs text eol=lf
tests/integration/ci-browser*.mjs text eol=lf
docs/evidence/cp028/** -text whitespace=trailing-space,space-before-tab,cr-at-eol
